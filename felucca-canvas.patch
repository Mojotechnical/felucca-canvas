new file mode 100644
index 0000000..a4fe6f1
--- /dev/null
+++ b/firmware/src/ui_canvas.c
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments; CANVAS: the Felucca Canvas fork */
+/* CANVAS (EDIT family, a CANVAS track only; after EDIT 2): the eight columns by eight cells of eng_canvas.c,
+ * placed and cleared by hand. Modelled on SLICES (ui_slice.c).
+ *   KNOB 1  COL    the cursor's column (1..8)
+ *   KNOB 2  ROW    the cursor's row (1..8, 1 = the top: the sample's start)
+ *   KNOB 3  CELL   right places a cell at the cursor, left clears it
+ *   KNOB 4  SCAN   moves every placed cell one row down (right) or up (left) per detent, wrapping: the canvas scans
+ *                  through the samples
+ *   KEYS    the first eight white keys F3 .. F4 are the cursor column's rows 1..8: a press places or clears that
+ *           cell (and moves the cursor's row there); lit = placed. They never sound on this page (seq.c CANVAS_KEYS,
+ *           song.grid 4); the other keys play as anywhere, so a cell can be placed while a chord rings
+ *   OCT- / OCT+  the octave, as on any value page
+ * The cells are the track's (eng_canvas.c cv_canvas): kept in projects, user presets and the undo copy. The page shows the canvas (ui_graph.c graph_canvas), the cells emitting grains lit in the accent
+ * (cv_part_t.lit, read and cleared here once a frame), the cursor, the placed count and SRC. */
+#if FELUCCA_CANVAS
+static struct {
+    uint8_t col, row;            /* the cursor */
+    uint8_t lit[CV_COLS];        /* the cells shown lit: those that emitted since the frame before, or in it */
+    uint8_t prev[CV_COLS];
+} cvs;
+
+static const uint8_t CANVAS_KEY_ROW[8] = {0, 2, 4, 6, 7, 9, 11, 12};   /* row r's key (F3 G3 A3 B3 C4 D4 E4 F4) */
+
+static int canvas_page_ok(void) { return TSEL->eng_req % NENGINES == ENGI_CANVAS; }
+static int canvas_page_on(void) { return !ui.home && cur_page()->graph == GR_CANVAS && canvas_page_ok(); }
+
+static uint32_t canvas_count(const track_t *t)
+{
+    uint32_t c, n = 0;
+    for (c = 0; c < CV_COLS; c++)
+        n += cv_popcount8(cv_cells(t, c));
+    return n;
+}
+
+/* the selected part's engine memory, when it holds CANVAS's state (0: another engine's, or not switched yet) */
+static cv_part_t *canvas_part(void)
+{
+    uint32_t p = (uint32_t)(TSEL - trk) % NPART;
+    return TSEL->engine % NENGINES == ENGI_CANVAS && eng_mem_owner[p] == ENGI_CANVAS + 1u ? cv_of(TSEL) : 0;
+}
+
+/* once a frame (graph_signature): the cells that emitted, shown for this frame and the next */
+static void canvas_lit_poll(void)
+{
+    cv_part_t *P = canvas_part();
+    uint32_t c;
+    for (c = 0; c < CV_COLS; c++) {
+        uint8_t now = 0;
+        if (P) {
+            now = P->lit[c];
+            P->lit[c] = 0;                               /* (the ISR may set a bit between: shown next frame) */
+        }
+        cvs.lit[c] = (uint8_t)(now | cvs.prev[c]);
+        cvs.prev[c] = now;
+    }
+}
+
+static void canvas_toggle(uint32_t c, uint32_t r, int on)
+{
+    uint32_t b = cv_cells(TSEL, c);
+    b = on ? b | (1u << r) : b & ~(1u << r);
+    cv_cells_set(TSEL, c, b);
+}
+
+/* KNOB 1 COL, 2 ROW, 3 CELL, 4 SCAN */
+static void canvas_knob(uint32_t slot, int32_t steps)
+{
+    uint32_t c, k, n;
+    if (slot == 0u) {
+        cvs.col = (uint8_t)clamp((int32_t)cvs.col + steps, 0, CV_COLS - 1);
+    } else if (slot == 1u) {
+        cvs.row = (uint8_t)clamp((int32_t)cvs.row + steps, 0, CV_ROWS - 1);
+    } else if (slot == 2u) {
+        canvas_toggle(cvs.col % CV_COLS, cvs.row % CV_ROWS, steps > 0);
+    } else if (slot == 3u) {
+        n = (uint32_t)(steps < 0 ? -steps : steps) % CV_ROWS;
+        for (c = 0; c < CV_COLS; c++) {
+            uint32_t b = cv_cells(TSEL, c);
+            for (k = 0; k < n; k++)                      /* down: row r -> r + 1, the last to the top */
+                b = steps > 0 ? ((b << 1) | (b >> 7)) & 0xFFu : ((b >> 1) | (b << 7)) & 0xFFu;
+            cv_cells_set(TSEL, c, b);
+        }
+    }
+}
+
+/* the keys pressed on the page (song.grid 4): the cursor column's cells */
+static void canvas_keys(uint32_t pressed)
+{
+    uint32_t r, c = cvs.col % CV_COLS;
+    for (r = 0; r < CV_ROWS; r++)
+        if ((pressed >> CANVAS_KEY_ROW[r]) & 1u) {
+            canvas_toggle(c, r, !((cv_cells(TSEL, c) >> r) & 1u));
+            cvs.row = (uint8_t)r;
+        }
+}
+
+/* ui_leds: the cursor column's placed cells on their keys (bit k = key k) */
+static uint32_t canvas_leds(void)
+{
+    uint32_t r, m = 0, b = cv_cells(TSEL, cvs.col % CV_COLS);
+    for (r = 0; r < CV_ROWS; r++)
+        if ((b >> r) & 1u)
+            m |= 1u << CANVAS_KEY_ROW[r];
+    return m;
+}
+
+/* graph_signature: what the page shows (and the lit cells, polled here once a frame) */
+static uint32_t canvas_sig(void)
+{
+    uint32_t h = 2166136261u, c;
+    canvas_lit_poll();
+    for (c = 0; c < CV_COLS; c++)
+        h = (h ^ (cv_cells(TSEL, c) | (uint32_t)cvs.lit[c] << 8)) * 16777619u;
+    h = (h ^ (cvs.col * 8u + cvs.row)) * 16777619u;
+    h = (h ^ (cv_src(TSEL->p) * 31u + cv_nzones(cv_src(TSEL->p)))) * 16777619u;
+    return h;
+}
+#else
+static int canvas_page_ok(void) { return 0; }
+static int canvas_page_on(void) { return 0; }
+#endif
