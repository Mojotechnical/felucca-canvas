diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
new file mode 100644
index 0000000..463b623
--- /dev/null
+++ b/.github/workflows/pages.yml
@@ -0,0 +1,53 @@
+# Felucca Canvas: build the firmware and publish the browser installer on GitHub Pages.
+# Repo Settings > Pages > Source: "GitHub Actions". Then every push to main (or "Run workflow")
+# builds build/felucca-<ver>.fwsc and deploys https://<you>.github.io/<repo>/ (the installer).
+name: Build and publish installer
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+permissions:
+  contents: read
+  pages: write
+  id-token: write
+concurrency:
+  group: pages
+  cancel-in-progress: true
+env:
+  RELEASE: "1.8-cnv"            # the version shown on the device (v1.8-cnv)
+jobs:
+  build:
+    runs-on: ubuntu-latest      # Linux x86-64: JieLi's toolchain runs natively
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: recursive
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Python packages
+        run: pip install Pillow fonttools
+      - name: JieLi toolchain
+        run: tools/get_toolchain.sh
+      - name: JieLi AC79 SDK (three package files)
+        run: git clone --depth 1 --branch AC79NN_SDK_V1.2.1_2023-12-13 https://gitee.com/Jieli-Tech/fw-AC79_AIoT_SDK.git ~/fw-AC79_AIoT_SDK
+      - name: Build the firmware
+        run: ./build.sh --release "$RELEASE"
+      - name: Make the installer site
+        run: python3 web/make_site.py "build/felucca-$RELEASE.fwsc" "$RELEASE" _site
+      - uses: actions/upload-artifact@v4
+        with:
+          name: felucca-canvas-fwsc
+          path: build/felucca-${{ env.RELEASE }}.fwsc
+      - uses: actions/upload-pages-artifact@v3
+        with:
+          path: _site
+  deploy:
+    needs: build
+    runs-on: ubuntu-latest
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}/webapp/installer/
+    steps:
+      - id: deployment
+        uses: actions/deploy-pages@v4
