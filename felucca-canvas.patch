diff --git a/firmware/src/eng_canvas.c b/firmware/src/eng_canvas.c
new file mode 100644
index 0000000..d303610
--- /dev/null
+++ b/firmware/src/eng_canvas.c
@@ -0,0 +1,455 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments; CANVAS: the Felucca Canvas fork */
+/* CANVAS: a granular canvas in the manner of a touch-grid granular instrument. Eight columns, each a sample; eight
+ * cells down each column, each an eighth of that sample (the top cell its start). Cells are placed or cleared on the
+ * EDIT > CANVAS page (ui_canvas.c); a held note emits grains from the placed cells, one cell at random per grain,
+ * pitched by the note against C4 (C4 plays the sample at its own speed). Nothing placed: silence.
+ *
+ * Material: the SAMPLE material as GRAIN plays it (IMA ADPCM in flash, decoded on demand from a seek index; see
+ * eng_grain.c for the decoder, the index and the cost bounds, which this engine shares). SRC picks the columns:
+ *   MIX     eight of the built-in zones, spread over all of them (piano, flute, sax: a different sample a column)
+ *   PIANO FLUTE SAX   the zones of that set, column c the zone c mod the set's zones
+ *   USR1..3 the zones of the user slot, column c zone c (uploaded with the web editor; up to 8 used here),
+ *           a slot with fewer zones repeats them as a set does
+ *
+ * The canvas is the track's: cv_canvas[track][column], bit r = row r (0 = the top), 8 bytes a track. A parameter is
+ * stored in a byte (-64..127: projects, user presets), so 64 cells cannot be parameters. They are kept where a CANVAS
+ * track has room: in a project, in the track's FM6 patch area (project.c: a CANVAS track has no FM6 patch; that area
+ * then holds canvas_pack's bytes and the patch loads as the init voice); in a user preset, in its FM6 patch entry
+ * (up_fm6.c, tagged with its record as an FM6 one is); the undo copy keeps them (ui.c undo.cv). A factory preset's
+ * canvas is CV_LAYOUT (ui.c apply_preset_to). A track switched to CANVAS takes preset 1's (set_engine_of).
+ *
+ * EDIT 1: SRC; SIZE the grain length (10 ms .. ~0.66 s); DENS grains a second a voice (1 .. ~98); SPRY the random
+ * spread from the cell's start (0: exactly there; 32: anywhere in the cell; 127: about four cells down), also
+ * jittering the grain interval. EDIT 2: PTCH semitones on the note; RAND a random detune a grain (quadratic, up to
+ * +-1 octave); TONE a one-pole low-pass (127 open); SKIP the chance a grain is left out (0..100 %). The track's SHP
+ * modulation (LFO / ENV -> SHP, the matrix) scans every grain's position over the whole sample, wrapping; FLT
+ * modulation moves TONE. Grains: Hann windowed, forward only, at most CV_NG a part shared by its voices (CV_POLY),
+ * each level 1 / sqrt(overlap) as GRAIN's.
+ *
+ * Cells that started a grain set their bit in cv_part_t.lit (the page lights them; the UI clears it, a byte a
+ * column: a lost bit only means one cell not flashing once). */
+#define CV_COLS 8u
+#define CV_ROWS 8u
+#define CV_POLY 4                /* voices per part */
+#define CV_NG 16                 /* grains per part */
+#define CV_NIDX GR_NIDX          /* seek index entries per part (eight 0.47 s zones: ~330; a full user slot ~650) */
+#define CV_C4 (60 * 16)          /* the note that plays a sample at its own speed, 1/16 semitones */
+
+enum { CV_SRC_MIX, CV_SRC_PIANO, CV_SRC_FLUTE, CV_SRC_SAX, CV_SRC_USR1, CV_SRC_USR2, CV_SRC_USR3, CV_SRC_N };
+static const char *const N_CV_SRC[CV_SRC_N] = {"MIX", "PIANO", "FLUTE", "SAX", "USR1", "USR2", "USR3"};
+static const uint8_t CV_SRC_SET[CV_SRC_N] = {0xFF, 0, 2, 3, SMP_NSETS, SMP_NSETS + 1, SMP_NSETS + 2};   /* SMP_ALL index */
+#define CV_NZB ((uint32_t)NELEM(SMP_ZONES))  /* the built-in zones */
+
+typedef struct {
+    const smp_zone_t *z;
+    uint32_t pos;                /* the next sample to decode */
+    int32_t frac;                /* Q16 between a and b */
+    uint32_t step;               /* Q16 source samples per output sample */
+    uint32_t wph, winc;          /* window phase: one turn = the grain */
+    uint32_t left;               /* output samples to go */
+    int32_t a, b;                /* the two source samples around the read position */
+    int32_t pred, idx;           /* ADPCM state */
+    int32_t gain;                /* Q15 */
+    uint8_t owner;               /* voice index + 1, 0 = free */
+    uint8_t col;
+} cv_grain_t;
+
+typedef struct {
+    cv_grain_t g[CV_NG];
+    int16_t ipred[CV_NIDX];      /* seek index: the decoder state before sample k * GR_SEG of a zone */
+    uint8_t iidx[CV_NIDX];
+    const smp_zone_t *zp[CV_COLS];   /* the distinct zones the columns play (column c: zp[c % nz]) */
+    uint16_t zbase[CV_COLS], zcnt[CV_COLS], zdone[CV_COLS];
+    uint32_t stamp;              /* what the index was built for (user slots: smp_user_gen) */
+    uint8_t src;                 /* SRC + 1 the index holds, 0 = none */
+    uint8_t nz;                  /* 0: no material (silent) */
+    volatile uint8_t lit[CV_COLS];   /* bit r: cell (c, r) started a grain since the page last looked */
+} cv_part_t;
+ENG_MEM_FITS("CANVAS", sizeof(cv_part_t));
+static int32_t cv_rng[NPART];
+
+static uint32_t cv_partno(const track_t *t) { return (uint32_t)(t - trk) % NPART; }
+static cv_part_t *cv_of(const track_t *t) { return (cv_part_t *)ENG_MEM(cv_partno(t)); }
+static inline uint32_t cv_rnd(const track_t *t) { return noise32(&cv_rng[cv_partno(t)]); }
+static uint32_t cv_src(const int16_t *p) { return (uint32_t)clamp(p[P_E0], 0, CV_SRC_N - 1); }
+
+static uint8_t cv_canvas[NTRK][CV_COLS];          /* the cells: bit r of [track][column] = row r */
+static uint32_t cv_tr(const track_t *t) { return (uint32_t)(t - trk) % NTRK; }
+/* the cells of track t's column c (bit r = row r) */
+static uint32_t cv_cells(const track_t *t, uint32_t c) { return cv_canvas[cv_tr(t)][c % CV_COLS]; }
+static void cv_cells_set(const track_t *t, uint32_t c, uint32_t bits)
+{
+    cv_canvas[cv_tr(t)][c % CV_COLS] = (uint8_t)(bits & 0xFFu);
+}
+static uint32_t cv_popcount8(uint32_t b)
+{
+    b = b - ((b >> 1) & 0x55u);
+    b = (b & 0x33u) + ((b >> 2) & 0x33u);
+    return (b + (b >> 4)) & 0x0Fu;
+}
+
+/* the material SRC s has: how many distinct zones, zone k; 0 zones = none (an empty user slot, a build without
+ * the samples) */
+static uint32_t cv_nzones(uint32_t s)
+{
+    uint32_t si;
+    if (s == CV_SRC_MIX)
+        return CV_NZB < CV_COLS ? CV_NZB : CV_COLS;
+    si = CV_SRC_SET[s % CV_SRC_N];
+    if (smp_set_missing(si))
+        return 0;
+    si = si < SMP_NSETS ? SMP_SETS[si].nz : usr_nz[(si - SMP_NSETS) % SMP_USER_SLOTS];
+    return si < CV_COLS ? si : CV_COLS;
+}
+static const smp_zone_t *cv_zone_of(uint32_t s, uint32_t k)
+{
+    uint32_t si;
+    if (s == CV_SRC_MIX)                                /* spread over every built-in zone */
+        return &SMP_ZONES[CV_NZB > CV_COLS ? k * CV_NZB / CV_COLS : k];
+    si = CV_SRC_SET[s % CV_SRC_N];
+    return si < SMP_NSETS ? &SMP_ZONES[SMP_SETS[si].z0 + k] : &usr_zone[(si - SMP_NSETS) % SMP_USER_SLOTS][k & 15u];
+}
+static uint32_t cv_stamp(uint32_t s) { return s >= CV_SRC_USR1 ? smp_user_gen : 0u; }
+
+static void cv_reset(cv_part_t *P, uint32_t s)
+{
+    uint32_t i, tot = 0, nz = cv_nzones(s);
+    P->src = (uint8_t)(s + 1u);
+    P->stamp = cv_stamp(s);
+    P->nz = 0;
+    for (i = 0; i < CV_NG; i++)
+        P->g[i].owner = 0;
+    for (i = 0; i < nz; i++) {
+        const smp_zone_t *z = cv_zone_of(s, i);
+        uint32_t c = z->n >= 8u ? (z->n + GR_SEG - 1u) >> GR_SEG_LOG2 : 0u;
+        if (tot + c > CV_NIDX)
+            c = 0;                                      /* past the capacity: that column stays silent */
+        P->zp[i] = z;
+        P->zbase[i] = (uint16_t)tot;
+        P->zcnt[i] = (uint16_t)c;
+        P->zdone[i] = c ? 1u : 0u;
+        if (c) {
+            P->ipred[tot] = 0;                          /* a zone starts at the state (0, 0) */
+            P->iidx[tot] = 0;
+        }
+        tot += c;
+    }
+    P->nz = (uint8_t)nz;
+}
+
+/* one index entry: the least built zone of the columns with cells, then the first zone not done */
+static void cv_build(cv_part_t *P, const track_t *t)
+{
+    uint32_t i, zl = CV_COLS, k, e, pos;
+    int32_t pred, idx;
+    for (i = 0; i < CV_COLS && P->nz; i++) {           /* the columns with cells first, the least built of them */
+        uint32_t z = i % P->nz;
+        if (cv_cells(t, i) && P->zdone[z] < P->zcnt[z] && (zl == CV_COLS || P->zdone[z] < P->zdone[zl]))
+            zl = z;
+    }
+    for (i = 0; i < P->nz && zl == CV_COLS; i++)
+        if (P->zdone[i] < P->zcnt[i])
+            zl = i;
+    if (zl == CV_COLS)
+        return;
+    k = P->zdone[zl];
+    e = P->zbase[zl] + k - 1u;
+    pred = P->ipred[e];
+    idx = P->iidx[e];
+    pos = (k - 1u) << GR_SEG_LOG2;
+    for (i = 0; i < GR_SEG; i++)
+        gr_dec(P->zp[zl], pos + i, &pred, &idx);
+    P->ipred[e + 1u] = (int16_t)pred;
+    P->iidx[e + 1u] = (uint8_t)idx;
+    P->zdone[zl] = (uint16_t)(k + 1u);
+}
+
+/* the cells of column c whose start the index reaches (a grain can start there now) */
+static uint32_t cv_ready_cells(const cv_part_t *P, const track_t *t, uint32_t c)
+{
+    uint32_t zl = c % P->nz, b = cv_cells(t, c), r, cellw = P->zp[zl]->n / CV_ROWS, ok = 0;
+    if (!P->zcnt[zl])
+        return 0;
+    for (r = 0; r < CV_ROWS; r++)
+        if (((b >> r) & 1u) && ((r * cellw) >> GR_SEG_LOG2) < P->zdone[zl])
+            ok |= 1u << r;
+    return ok;
+}
+
+/* start a grain of voice vi from a placed cell picked at random among those the index reaches (while it builds,
+ * after an engine switch or a new SRC, the cells further down a sample join as it gets there); 0 = none could start
+ * (the voice tries again a few blocks on), 1 = started or left out by SKIP */
+static int cv_spawn(cv_part_t *P, const track_t *t, uint32_t vi, uint32_t iv, const vmod_t *m)
+{
+    const int16_t *p = t->p;
+    cv_grain_t *g = 0;
+    const smp_zone_t *z;
+    uint32_t i, c, r = 0, bits = 0, tot = 0, pick, zl, n, len, step, span, cellw, sp, load, ov, room;
+    uint32_t r1 = cv_rnd(t), r2 = cv_rnd(t);
+    int32_t d16, pos, shift;
+    uint32_t ready[CV_COLS];
+    for (i = 0; i < CV_NG && !g; i++)
+        if (!P->g[i].owner)
+            g = &P->g[i];
+    if (!g || !P->nz)
+        return 1;                                       /* (no grain free: the interval as usual) */
+    if (((r1 >> 16) & 127u) < (uint32_t)p[P_E7])
+        return 1;                                       /* SKIP: this grain left out */
+    for (c = 0; c < CV_COLS; c++)
+        tot += cv_popcount8(ready[c] = cv_ready_cells(P, t, c));
+    if (!tot)
+        return 0;                                       /* an empty canvas (silence), or nothing indexed yet */
+    pick = (r1 & 0xFFFFu) % tot;                        /* the pick-th ready cell, columns left to right */
+    for (c = 0; c < CV_COLS; c++) {
+        uint32_t k = cv_popcount8(bits = ready[c]);
+        if (pick < k)
+            break;
+        pick -= k;
+    }
+    for (r = 0; r < CV_ROWS; r++)
+        if (((bits >> r) & 1u) && !pick--)
+            break;
+    zl = c % P->nz;
+    z = P->zp[zl];
+    n = z->n;
+    if (n < 64u || !P->zcnt[zl])
+        return 1;
+    /* length: 441 * 2^(SIZE / 21) output samples (10 ms .. ~0.66 s) */
+    len = (441u * pow2_q16(p[P_E1] * 64 / 7)) >> 16;
+    /* rate: the note against C4 + PTCH + RAND's random detune (RAND^2, up to +-1 octave), at the zone's own speed */
+    {
+        int32_t amt = p[P_E5] * p[P_E5] * 192 / (127 * 127);
+        d16 = m->pitch16 - CV_C4 + p[P_E4] * 16 + ((((int32_t)(r2 >> 16)) - 32768) * amt >> 15);
+    }
+    step = (pow2_q16(clamp(d16, -1536, 576)) >> 8) * (z->rate >> 8);
+    step = step > GR_STEP_MAX ? GR_STEP_MAX : step < 256u ? 256u : step;
+    span = (len * (step >> 8)) >> 8;                    /* source samples the grain reads */
+    if (span + 4u > n / 2u) {                           /* at most half the zone: room to place it */
+        span = n / 2u - 4u;
+        len = (span << 8) / (step >> 8);
+    }
+    if (len < 16u)
+        return 1;
+    room = n - 3u - span;                               /* the starts a grain can take */
+    /* position: the cell's start, SPRY's spread down from it, SHP's scan (wraps over the whole zone) */
+    cellw = n / CV_ROWS;
+    sp = (cellw * (uint32_t)p[P_E3]) >> 5;              /* SPRY 32: a cell; 127: ~4 cells */
+    pos = (int32_t)(r * cellw) + (int32_t)(sp ? gr_scale(sp, r2 & 0xFFFFu) : 0u);
+    shift = m->shape - (64 << 8);                       /* +-64 << 8: +-half the zone */
+    pos += (int32_t)(((int64_t)shift * (int32_t)n) >> 15);
+    pos %= (int32_t)room;
+    if (pos < 0)
+        pos += (int32_t)room;
+    if ((uint32_t)pos >> GR_SEG_LOG2 >= P->zdone[zl])   /* (SPRY or SHP past what is indexed: its last sample; */
+        pos = (int32_t)(((uint32_t)P->zdone[zl] << GR_SEG_LOG2) - 1u);   /* the grain decodes on from there) */
+    for (i = 0, load = step; i < CV_NG; i++)            /* the part's decode load: a cap on the cost */
+        if (P->g[i].owner)
+            load += P->g[i].step;
+    if (load > GR_LOAD_MAX)
+        return 1;
+    g->z = z;
+    g->step = step;
+    g->frac = 0;
+    g->wph = 0;
+    g->winc = 0xFFFFFFFFu / len;
+    g->left = len;
+    g->col = (uint8_t)c;
+    ov = len / (iv ? iv : 1u);
+    g->gain = GR_NORM[ov < 1u ? 1u : ov > GR_NG ? GR_NG : ov];
+    g->owner = (uint8_t)(vi + 1u);
+    {                                                   /* the decoder at pos: the entry below, then up to 255 */
+        uint32_t e = P->zbase[zl] + ((uint32_t)pos >> GR_SEG_LOG2), q;
+        int32_t pr = P->ipred[e], ix = P->iidx[e];
+        for (q = (uint32_t)pos & ~(GR_SEG - 1u); q < (uint32_t)pos; q++)
+            gr_dec(z, q, &pr, &ix);
+        g->pred = pr;
+        g->idx = ix;
+    }
+    g->a = gr_dec(z, (uint32_t)pos, &g->pred, &g->idx);
+    g->b = gr_dec(z, (uint32_t)pos + 1u, &g->pred, &g->idx);
+    g->pos = (uint32_t)pos + 2u;
+    P->lit[c] |= (uint8_t)(1u << r);
+    return 1;
+}
+
+/* one grain into acc; returns 0 when it ended (as eng_grain.c gr_run, forward only) */
+static int cv_run(cv_grain_t *g, int32_t *acc, uint32_t n)
+{
+    uint32_t i, m = n < g->left ? n : g->left, step = g->step, pos = g->pos;
+    int32_t a = g->a, b = g->b, frac = g->frac, w0, w1, wq, dq, pred = g->pred, idx = g->idx;
+    const smp_zone_t *z = g->z;
+    w0 = mulq15(gr_win(g->wph), g->gain);
+    g->wph += g->winc * m;
+    g->left -= m;
+    w1 = g->left ? mulq15(gr_win(g->wph), g->gain) : 0;
+    wq = w0 * 1024;
+    dq = m == CTL ? ((w1 - w0) * 1024) >> CTL_LOG2 : m ? (w1 - w0) * 1024 / (int32_t)m : 0;
+    for (i = 0; i < m; i++) {
+        int32_t s = a + (((b - a) * (frac >> 1)) >> 15);
+        acc[i] += (s * (wq >> 10)) >> 15;
+        wq += dq;
+        frac += (int32_t)step;
+        while (frac >= 65536) {
+            frac -= 65536;
+            a = b;
+            b = pos < z->n ? gr_dec(z, pos++, &pred, &idx) : a;
+        }
+    }
+    g->pred = pred;
+    g->idx = idx;
+    g->pos = pos;
+    g->a = a;
+    g->b = b;
+    g->frac = frac;
+    if (!g->left)
+        g->owner = 0;
+    return g->left != 0;
+}
+
+static void canvas_note_on(track_t *t, voice_t *v)
+{
+    cv_part_t *P = cv_of(t);
+    uint32_t vi = (uint32_t)(v - t->v) % NVOICE, i;
+    v->s[1] = 0;                                        /* the first grain at once */
+    if (!v->env) {                                      /* a fresh voice: no grains left from before */
+        for (i = 0; i < CV_NG; i++)
+            if (P->g[i].owner == vi + 1u)
+                P->g[i].owner = 0;
+        v->s[2] = 0;
+    }
+}
+
+/* per part and block: the index follows SRC (and a new upload), grains of ended voices go, one index entry */
+static void canvas_block(track_t *t)
+{
+    cv_part_t *P = cv_of(t);
+    uint32_t s = cv_src(t->p), i;
+    if (!cv_rng[cv_partno(t)])
+        cv_rng[cv_partno(t)] = 0x6C8E9CF5;
+    if (P->src != s + 1u || P->stamp != cv_stamp(s))
+        cv_reset(P, s);
+    for (i = 0; i < CV_NG; i++)
+        if (P->g[i].owner && !t->v[(P->g[i].owner - 1u) % NVOICE].active)
+            P->g[i].owner = 0;
+    cv_build(P, t);
+}
+
+static void canvas_render(track_t *t, voice_t *v, int32_t *out, uint32_t n, const vmod_t *m)
+{
+    cv_part_t *P = cv_of(t);
+    const int16_t *p = t->p;
+    uint32_t vi = (uint32_t)(v - t->v) % NVOICE, i, mine = 0, nact = 0, iv;
+    int32_t acc[CTL], lp, y = v->s[2];
+    if (n > CTL)
+        n = CTL;
+    if (!P->nz || P->src != cv_src(p) + 1u)
+        return;                                         /* no material (an empty user slot): silent */
+    for (i = 0; i < n; i++)
+        acc[i] = 0;
+    for (i = 0; i < CV_POLY; i++)
+        nact += t->v[i].active;
+    for (i = 0; i < CV_NG; i++)
+        if (P->g[i].owner == vi + 1u)
+            mine += cv_run(&P->g[i], acc, n);
+    /* the next grain: DENS a second, 1..98 /s (SPRY jitters the interval) */
+    iv = (44100u * pow2_q16(-p[P_E2] * 10)) >> 16;
+    v->s[1] -= (int32_t)n;
+    if (v->s[1] <= 0) {
+        uint32_t r = cv_rnd(t);
+        int32_t j = (((int32_t)(r & 0xFFFFu) - 32768) * p[P_E3]) / 254;   /* +-SPRY / 2, Q15 */
+        v->s[1] += (int32_t)iv + mulq15((int32_t)iv, j);
+        if (v->s[1] < 0)
+            v->s[1] = 0;
+        if (mine < (nact > 1u ? (CV_NG / nact > 2u ? CV_NG / nact : 2u) : CV_NG) && !cv_spawn(P, t, vi, iv, m))
+            v->s[1] = 4 * CTL;                          /* nothing could start: again in four blocks */
+    }
+    lp = 4000 + ((clamp((p[P_E6] << 8) + m->cutoff, 0, 127 << 8) * 28767) >> 15);   /* TONE + FLT modulation */
+    for (i = 0; i < n; i++) {
+        y += mulq15(clamp(acc[i], -65535, 65535) - y, lp);
+        out[i] += voice_amp(y, m, i) << 1;
+    }
+    v->s[2] = y;
+}
+
+/* the factory canvases (preset k: CV_LAYOUT[k], a byte a column, bit r = row r) */
+static const uint8_t CV_LAYOUT[][CV_COLS] = {
+    {0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80},   /* DIAGONAL */
+    {0x18, 0x00, 0x3C, 0x00, 0x00, 0x18, 0x00, 0x00},   /* CLOUDS: middles, three columns */
+    {0x01, 0x00, 0x00, 0x01, 0x00, 0x00, 0x01, 0x00},   /* STRIKES: the attacks */
+    {0x55, 0xAA, 0x55, 0xAA, 0x55, 0xAA, 0x55, 0xAA},   /* CHECKER */
+    {0x00, 0xF0, 0x00, 0x00, 0x0F, 0x00, 0x00, 0x00},   /* DRONE: two long stripes */
+    {0x80, 0x40, 0x20, 0x10, 0x08, 0x04, 0x02, 0x01},   /* RETRO */
+};
+static const preset_t CANVAS_PRESETS[] = {
+    /* name, {SRC, SIZE, DENS, SPRY, PTCH, RAND, TONE, SKIP}, {A D S R}, fenv, mono (the canvas: CV_LAYOUT) */
+    {"DIAGONAL", {CV_SRC_MIX, 70, 80, 24, 0, 6, 120, 0}, {30, 90, 120, 80}, 0, 0, FX(0, 30, 25, 80), PAT(5)},
+    {"CLOUDS", {CV_SRC_MIX, 96, 100, 40, 0, 14, 100, 0}, {80, 90, 127, 100}, 0, 0, FX(0, 50, 20, 100), PAT(5)},
+    {"STRIKES", {CV_SRC_PIANO, 40, 60, 4, 0, 0, 127, 20}, {0, 80, 90, 50}, 0, 0, FX(0, 20, 40, 60), PAT(7)},
+    {"CHECKER", {CV_SRC_MIX, 24, 118, 20, 0, 30, 110, 40}, {10, 70, 110, 40}, 0, 0, FX(0, 20, 50, 50), PAT(6)},
+    {"DRONE", {CV_SRC_FLUTE, 110, 90, 60, -12, 10, 90, 0}, {90, 100, 127, 110}, 0, 0, FX(0, 60, 20, 110), PAT(8)},
+    {"RETRO", {CV_SRC_SAX, 64, 96, 28, 0, 20, 115, 10}, {40, 90, 120, 80}, 0, 0, FX(0, 40, 35, 85), PAT(3)},
+};
+_Static_assert(NELEM(CV_LAYOUT) == NELEM(CANVAS_PRESETS), "a canvas for every CANVAS preset");
+
+/* ui.c apply_preset_to: preset pi's canvas into track t */
+static void canvas_load_layout(const track_t *t, uint32_t pi)
+{
+    uint32_t c;
+    for (c = 0; c < CV_COLS; c++)
+        cv_cells_set(t, c, CV_LAYOUT[pi % NELEM(CV_LAYOUT)][c]);
+}
+
+/* the canvas of track tr in an FM6 patch area (FM6_PACKED bytes of 7 bits: projects, user presets): 64 bits in
+ * bytes 0..9 (7 a byte, column 0's row 0 first), then the mark CV_MARK0 CV_MARK1, the rest 0 */
+#define CV_MARK0 0x43u           /* 'C' */
+#define CV_MARK1 0x56u           /* 'V' */
+static void canvas_pack(uint32_t tr, uint8_t *pk)
+{
+    uint32_t i;
+    for (i = 0; i < FM6_PACKED; i++)
+        pk[i] = 0;
+    for (i = 0; i < 64u; i++)                           /* bit i = column i / 8, row i % 8 (32-bit operations only) */
+        if ((cv_canvas[tr % NTRK][i >> 3] >> (i & 7u)) & 1u)
+            pk[i / 7u] |= (uint8_t)(1u << (i % 7u));
+    pk[10] = CV_MARK0;
+    pk[11] = CV_MARK1;
+}
+/* .. and back: 1 = it held a canvas (else track tr's canvas is left as it is) */
+static int canvas_unpack(uint32_t tr, const uint8_t *pk)
+{
+    uint8_t c[CV_COLS] = {0};
+    uint32_t i;
+    if (pk[10] != CV_MARK0 || pk[11] != CV_MARK1 || (pk[9] >> 1))
+        return 0;
+    for (i = 0; i < 64u; i++)
+        if ((pk[i / 7u] >> (i % 7u)) & 1u)
+            c[i >> 3] |= (uint8_t)(1u << (i & 7u));
+    for (i = 0; i < CV_COLS; i++)
+        cv_canvas[tr % NTRK][i] = c[i];
+    return 1;
+}
+
+static const engine_t ENG_CANVAS = {
+    .name = "CANVAS",
+    .page_title = {"GRAN", "EMIT"},
+    .edit = {
+        {"SRC", F_ENUM, 0, CV_SRC_N - 1, CV_SRC_MIX, N_CV_SRC, 0},
+        {"SIZE", F_PCT, 0, 127, 70, 0, 0},
+        {"DENS", F_PCT, 0, 127, 80, 0, 0},
+        {"SPRY", F_PCT, 0, 127, 24, 0, 0},
+        {"PTCH", F_SEMI, -24, 24, 0, 0, 0},
+        {"RAND", F_PCT, 0, 127, 6, 0, 0},
+        {"TONE", F_PCT, 0, 127, 120, 0, 0},
+        {"SKIP", F_PCT, 0, 127, 0, 0, 0},
+    },
+    .presets = CANVAS_PRESETS,
+    .npresets = NELEM(CANVAS_PRESETS),
+    .note_on = canvas_note_on,
+    .render = canvas_render,
+    .knob = {P_E1, P_E2, P_E3, P_E0},
+    .poly = CV_POLY,
+    .sampled = 1,
+    .block = canvas_block,
+    .mem = sizeof(cv_part_t),
+};
