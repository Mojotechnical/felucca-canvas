diff --git a/tests/canvas_test.c b/tests/canvas_test.c
new file mode 100644
index 0000000..643317b
--- /dev/null
+++ b/tests/canvas_test.c
@@ -0,0 +1,485 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments; CANVAS: the Felucca Canvas fork */
+/* CANVAS engine test (src/eng_canvas.c) through hostsim.c, as noise_test.c.
+ *   build/host/canvas_test [DEMODIR]          (run_tests.sh: build/canvas_demo)
+ * 1. the cell words: cv_cells / cv_cells_set round trip for every column and byte, the other columns untouched.
+ * 2. every preset: C4 held 1.5 s sounds (RMS), no clipping (|voice sum| < 2 x full scale), no DC; the voices end
+ *    after the release; the preset's canvas is CV_LAYOUT's.
+ * 3. an empty canvas is silent; one placed cell emits only from it: every grain's column zone is that column's,
+ *    its start at the cell's start (SPRY 0, no SHP modulation), only that cell lit. A fresh part (empty index) sounds at
+ *    once from the cells indexed, a deep cell as soon as the index reaches it.
+ * 4. SPRY 32 keeps grains within the cell; the row order runs down the sample.
+ * 5. pitch: C5 reads twice as fast as C4, C3 half (the grain step), at the zone's own rate.
+ * 6. SRC: an empty user slot is silent and engines.c snd_missing names it; MIX columns are distinct zones.
+ * 7. engine switches GRAIN <-> CANVAS <-> SAMPLE <-> CANVAS on a sounding part: no stale grain (the region zeroed).
+ * 8. determinism: the same note from silence renders the same samples again.
+ * 9. cost: ns per sample of CANVAS at its heaviest (4 voices, DENS 127, SIZE 127, every cell) against GRAIN's
+ *    heaviest preset with the same notes: at most CANVAS_COST_RATIO times.
+ * 10. demos into DEMODIR: every preset playing a chord; CLOUDS scanned by a slow LFO -> SHP. */
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+
+#define CANVAS_COST_RATIO 1.6
+#define ENGI_GRAIN_IDX 8u      /* engines.c ENGINES[] */
+
+static int bad;
+static void check(const char *what, int ok)
+{
+    printf("canvas: %-84s %s\n", what, ok ? "ok" : "FAIL");
+    bad += !ok;
+}
+
+static void setup(uint32_t pi)
+{
+    memset(trk, 0, sizeof trk);
+    host_tracks_init();
+    host_preset(&trk[0], ENGI_CANVAS, pi);
+    trk[0].p[P_CHOR] = trk[0].p[P_DLY] = trk[0].p[P_REV] = 0;
+}
+
+/* track 0's voice sum for n samples (y may be 0): peak, rms, mean */
+static void render(uint32_t n, double *y, double *peak, double *rms, double *mean)
+{
+    static int32_t b[CTL];
+    uint32_t i, k;
+    double pk = 0, s2 = 0, s1 = 0;
+    for (i = 0; i < n; i += CTL) {
+        memset(b, 0, sizeof b);
+        track_render(&trk[0], b, CTL);
+        for (k = 0; k < CTL && i + k < n; k++) {
+            double v = b[k] / 32768.0;
+            if (y) y[i + k] = v;
+            pk = fabs(v) > pk ? fabs(v) : pk;
+            s2 += v * v;
+            s1 += v;
+        }
+    }
+    if (peak) *peak = pk;
+    if (rms) *rms = sqrt(s2 / n);
+    if (mean) *mean = s1 / n;
+}
+
+static int voices_active(const track_t *t)
+{
+    uint32_t i, n = 0;
+    for (i = 0; i < NVOICE; i++)
+        n += t->v[i].active;
+    return (int)n;
+}
+
+static void canvas_clear(const track_t *t)
+{
+    uint32_t c;
+    for (c = 0; c < CV_COLS; c++)
+        cv_cells_set(t, c, 0);
+}
+
+/* run blocks and watch the grains: every new grain's column, start (its first two decodes done: pos - 2), step */
+typedef struct { uint32_t n, cols, bad_zone, min_start, max_start; uint32_t step_sum; } gstat_t;
+static void watch(uint32_t blocks, gstat_t *st)
+{
+    static int32_t b[CTL];
+    cv_part_t *P = cv_of(&trk[0]);
+    uint32_t i, k, seen[CV_NG];
+    memset(st, 0, sizeof *st);
+    st->min_start = 0xFFFFFFFFu;
+    for (k = 0; k < CV_NG; k++)
+        seen[k] = 0;
+    for (i = 0; i < blocks; i++) {
+        uint8_t before[CV_NG];
+        for (k = 0; k < CV_NG; k++)
+            before[k] = P->g[k].owner;
+        memset(b, 0, sizeof b);
+        track_render(&trk[0], b, CTL);
+        for (k = 0; k < CV_NG; k++) {
+            cv_grain_t *g = &P->g[k];
+            /* a grain started this block: free before (or ended and restarted: wph back near 0) */
+            if (g->owner && (!before[k] || g->wph < g->winc * (CTL + 1u)) && seen[k] != g->left + g->pos) {
+                uint32_t start;
+                uint32_t used = (uint32_t)(((uint64_t)(g->winc ? (g->wph / g->winc) : 0) * g->step) >> 16);
+                seen[k] = g->left + g->pos;
+                start = g->pos - 2u - used;
+                st->n++;
+                st->cols |= 1u << g->col;
+                if (g->z != P->zp[g->col % (P->nz ? P->nz : 1u)])
+                    st->bad_zone++;
+                st->min_start = start < st->min_start ? start : st->min_start;
+                st->max_start = start > st->max_start ? start : st->max_start;
+                st->step_sum += g->step;
+            }
+        }
+    }
+}
+
+int main(int argc, char **argv)
+{
+    const char *demo = argc > 1 ? argv[1] : 0;
+    uint32_t pi, c, r, k;
+    static double y[FS * 4];
+    double pk, rms, mean;
+    char buf[160];
+
+    /* 1. the cells: per track, and through the FM6 patch area (projects, user presets) */
+    {
+        uint8_t pk[FM6_PACKED], keep[CV_COLS];
+        int ok = 1;
+        uint32_t tr;
+        memset(cv_canvas, 0, sizeof cv_canvas);
+        for (tr = 0; tr < NTRK; tr++)
+            for (c = 0; c < CV_COLS; c++)
+                cv_cells_set(&trk[tr], c, (tr * 37u + c * 101u + 5u) & 0xFFu);
+        for (tr = 0; tr < NTRK; tr++)
+            for (c = 0; c < CV_COLS; c++)
+                ok &= cv_cells(&trk[tr], c) == ((tr * 37u + c * 101u + 5u) & 0xFFu);
+        for (k = 0; k < 64u && ok; k++) {                /* every single cell, and full / empty */
+            uint64_t want = k < 62u ? 1ull << k : k == 62u ? ~0ull : 0ull;
+            uint32_t i, maxb = 0;
+            for (c = 0; c < CV_COLS; c++)
+                cv_canvas[1][c] = (uint8_t)(want >> (8u * c));
+            memcpy(keep, cv_canvas[1], CV_COLS);
+            canvas_pack(1, pk);
+            for (i = 0; i < FM6_PACKED; i++)
+                maxb = pk[i] > maxb ? pk[i] : maxb;
+            memset(cv_canvas[1], 0, CV_COLS);
+            ok &= maxb <= 127u && canvas_unpack(1, pk) && !memcmp(keep, cv_canvas[1], CV_COLS);
+        }
+        memcpy(pk, FM6_INIT, FM6_PACKED);               /* an FM6 patch is not a canvas */
+        memset(cv_canvas[2], 0x5A, CV_COLS);
+        ok &= !canvas_unpack(2, pk) && cv_canvas[2][3] == 0x5Au;
+        check("cells: per track; packed into an FM6 area (7-bit bytes) and back, every cell; a patch is no canvas", ok);
+    }
+
+    /* 2. every preset */
+    for (pi = 0; pi < ENG_CANVAS.npresets; pi++) {
+        int lay = 1;
+        setup(pi);
+        for (k = 0; k < CV_COLS; k++)
+            lay &= cv_cells(&trk[0], k) == CV_LAYOUT[pi][k];
+        trk_note_on(&trk[0], 60, 100);
+        render(FS / 2u, 0, 0, 0, 0);                   /* (the index builds, the attack) */
+        render(FS, y, &pk, &rms, &mean);
+        trk_note_off(&trk[0], 60);
+        render(FS * 8u, 0, 0, 0, 0);                   /* (DRONE's REL 110: several seconds) */
+        snprintf(buf, sizeof buf, "%-9s canvas %s, sounds (rms %.4f), peak %.3f < 2, |dc| %.5f < 0.01, voices end",
+                 ENG_CANVAS.presets[pi].name, lay ? "as CV_LAYOUT" : "WRONG", rms, pk, fabs(mean));
+        check(buf, lay && rms > 0.004 && pk < 2.0 && fabs(mean) < 0.01 && !voices_active(&trk[0]));
+    }
+
+    /* 3. empty canvas: silence; one cell: only it */
+    setup(0);
+    canvas_clear(&trk[0]);
+    trk_note_on(&trk[0], 60, 100);
+    render(FS, 0, &pk, 0, 0);
+    check("empty canvas: silent", pk == 0.0);
+    for (c = 0; c < CV_COLS; c += 3u)
+        for (r = 0; r < CV_ROWS; r += 3u) {
+            gstat_t st;
+            cv_part_t *P;
+            uint32_t cellw, other = 0, j;
+            setup(0);
+            canvas_clear(&trk[0]);
+            cv_cells_set(&trk[0], c, 1u << r);
+            trk[0].p[P_E3] = 0;                        /* SPRY 0: exactly the cell's start */
+            trk[0].p[P_E1] = 30;                       /* short grains: room everywhere */
+            trk_note_on(&trk[0], 60, 100);
+            render(FS / 2u, 0, 0, 0, 0);
+            P = cv_of(&trk[0]);
+            for (j = 0; j < CV_COLS; j++)
+                P->lit[j] = 0;
+            watch(FS / CTL, &st);
+            cellw = P->zp[c % P->nz]->n / CV_ROWS;
+            for (j = 0; j < CV_COLS; j++)
+                other |= j == c ? P->lit[j] & ~(1u << r) : P->lit[j];
+            snprintf(buf, sizeof buf, "cell (%u, %u) alone: %u grains, all from column %u, start %u..%u (cell %u), lit only it",
+                     c + 1u, r + 1u, st.n, c + 1u, st.min_start, st.max_start, r * cellw);
+            check(buf, st.n > 10u && st.cols == 1u << c && !st.bad_zone && st.min_start + 1u >= r * cellw &&
+                       st.max_start <= r * cellw + 1u && !other && (P->lit[c] >> r & 1u));
+        }
+
+    /* 3b. a fresh part (its index empty, as after a switch to CANVAS or a new SRC): sound at once from the cells the
+     * index reaches, a deep cell alone as soon as the index gets there (one entry a block: ~60 ms for 7/8 of a zone) */
+    {
+        double pk2;
+        setup(0);                                      /* DIAGONAL: (1, 1) is ready at once */
+        trk_note_on(&trk[0], 60, 100);
+        render(FS / 100u, 0, &pk, 0, 0);               /* 10 ms */
+        setup(0);
+        canvas_clear(&trk[0]);
+        cv_cells_set(&trk[0], 5, 1u << 7);             /* (6, 8) alone: 7/8 down the zone */
+        trk_note_on(&trk[0], 60, 100);
+        render(FS / 7u, 0, &pk2, 0, 0);                /* ~140 ms */
+        snprintf(buf, sizeof buf, "fresh index: DIAGONAL sounds within 10 ms (peak %.3f), a cell 7/8 down within 140 ms (%.3f)",
+                 pk, pk2);
+        check(buf, pk > 0.01 && pk2 > 0.01);
+    }
+
+    /* 4. SPRY 32: within the cell (and a spread in it) */
+    {
+        gstat_t st;
+        cv_part_t *P;
+        uint32_t cellw;
+        setup(0);
+        canvas_clear(&trk[0]);
+        cv_cells_set(&trk[0], 2, 1u << 3);
+        trk[0].p[P_E3] = 32;
+        trk[0].p[P_E1] = 20;
+        trk[0].p[P_E2] = 110;
+        trk_note_on(&trk[0], 60, 100);
+        render(FS / 2u, 0, 0, 0, 0);
+        watch(2u * FS / CTL, &st);
+        P = cv_of(&trk[0]);
+        cellw = P->zp[2 % P->nz]->n / CV_ROWS;
+        snprintf(buf, sizeof buf, "SPRY 32: %u grains start in the cell %u..%u (got %u..%u), spread over half of it",
+                 st.n, 3u * cellw, 4u * cellw, st.min_start, st.max_start);
+        check(buf, st.n > 30u && st.min_start + 1u >= 3u * cellw && st.max_start <= 4u * cellw &&
+                   st.max_start - st.min_start > cellw / 2u);
+    }
+
+    /* 5. pitch: the grain step by note */
+    {
+        uint32_t s[3], notes[3] = {48, 60, 72};
+        for (k = 0; k < 3u; k++) {
+            gstat_t st;
+            setup(0);
+            canvas_clear(&trk[0]);
+            cv_cells_set(&trk[0], 0, 1u);
+            trk[0].p[P_E1] = 20;
+            trk[0].p[P_E5] = 0;                        /* RAND 0: no detune */
+            trk_note_on(&trk[0], notes[k], 100);
+            render(FS / 4u, 0, 0, 0, 0);
+            watch(FS / 2u / CTL, &st);
+            s[k] = st.n ? st.step_sum / st.n : 0u;
+        }
+        snprintf(buf, sizeof buf, "pitch: step C3 %u, C4 %u (zone rate %u), C5 %u: halves and doubles", s[0], s[1],
+                 cv_of(&trk[0])->zp[0]->rate, s[2]);
+        check(buf, s[1] && labs((long)s[1] - (long)cv_of(&trk[0])->zp[0]->rate) <= 256 &&
+                   labs((long)s[2] - 2L * s[1]) <= 512 && labs((long)s[0] * 2L - s[1]) <= 512);
+    }
+
+    /* 5b. EDIT 2: PTCH +12 doubles the step; SKIP 127 leaves out nearly every grain; TONE 0 darkens */
+    {
+        gstat_t st0, st1;
+        double hf[2];
+        setup(0);
+        canvas_clear(&trk[0]);
+        cv_cells_set(&trk[0], 0, 1u);
+        trk[0].p[P_E1] = 20;
+        trk[0].p[P_E5] = 0;
+        trk_note_on(&trk[0], 60, 100);
+        render(FS / 4u, 0, 0, 0, 0);
+        watch(FS / 2u / CTL, &st0);
+        trk[0].p[P_E4] = 12;
+        watch(FS / 2u / CTL, &st1);
+        snprintf(buf, sizeof buf, "PTCH +12: step %u -> %u (x2)", st0.n ? st0.step_sum / st0.n : 0u,
+                 st1.n ? st1.step_sum / st1.n : 0u);
+        check(buf, st0.n && st1.n && labs((long)(st1.step_sum / st1.n) - 2L * (st0.step_sum / st0.n)) <= 512);
+        trk[0].p[P_E4] = 0;
+        trk[0].p[P_E7] = 127;
+        watch(FS / CTL, &st1);
+        snprintf(buf, sizeof buf, "SKIP 127: %u grains a second against %u at SKIP 0", st1.n, 2u * st0.n);
+        check(buf, st1.n * 20u < 2u * st0.n);
+        for (k = 0; k < 2u; k++) {                   /* TONE 127 / 0: the first difference's energy against the signal's */
+            uint32_t i;
+            double e = 0, d = 0;
+            setup(1);
+            cv_rng[0] = 0x1234567;                         /* the same grains both times: only the filter differs */
+            trk[0].p[P_E6] = k ? 0 : 127;
+            trk_note_on(&trk[0], 84, 100);                /* (C6: above TONE 0's corner, ~0.9 kHz) */
+            render(FS / 2u, 0, 0, 0, 0);
+            render(FS / 2u, y, 0, 0, 0);
+            for (i = 1; i < FS / 2u; i++) {
+                e += y[i] * y[i];
+                d += (y[i] - y[i - 1]) * (y[i] - y[i - 1]);
+            }
+            hf[k] = e > 0 ? d / e : 0;
+        }
+        snprintf(buf, sizeof buf, "TONE 0 darker than 127: HF ratio %.4f < %.4f / 2", hf[1], hf[0]);
+        check(buf, hf[1] < hf[0] / 2);
+    }
+
+    /* 6. SRC */
+    {
+        uint32_t code = 0;
+        const char *miss;
+        setup(0);
+        trk[0].p[P_E0] = CV_SRC_USR2;                  /* (no user slots on the host) */
+        trk_note_on(&trk[0], 60, 100);
+        render(FS / 2u, 0, &pk, 0, 0);
+        trk[0].eng_req = ENGI_CANVAS;
+        miss = snd_missing(&trk[0], &code);
+        snprintf(buf, sizeof buf, "SRC USR2 empty: silent (peak %.4f), snd_missing says %s", pk, miss ? miss : "nothing");
+        check(buf, pk == 0.0 && miss && !strcmp(miss, "USR2"));
+        setup(0);
+        trk[0].p[P_E0] = CV_SRC_MIX;
+        render(CTL, 0, 0, 0, 0);
+        {
+            cv_part_t *P = cv_of(&trk[0]);
+            uint32_t i, j, distinct = 1;
+            for (i = 0; i < P->nz; i++)
+                for (j = 0; j < i; j++)
+                    distinct &= P->zp[i] != P->zp[j];
+            snprintf(buf, sizeof buf, "SRC MIX: %u columns of distinct built-in zones (of %u)", P->nz, CV_NZB);
+            check(buf, P->nz == (CV_NZB < CV_COLS ? CV_NZB : CV_COLS) && distinct);
+        }
+    }
+
+    /* 7. engine switches on a sounding part */
+    {
+        static const uint32_t seq[4] = {ENGI_GRAIN_IDX, ENGI_CANVAS, ENGI_SAMPLE, ENGI_CANVAS};
+        int ok = 1;
+        setup(1);
+        trk_note_on(&trk[0], 60, 100);
+        render(FS / 2u, 0, 0, 0, 0);
+        for (k = 0; k < 4u; k++) {
+            host_preset_req(&trk[0], seq[k], 0);       /* as the UI: the ISR switches after the fade */
+            {                                          /* the whole audio path (seq.c: engine_block) */
+                static int32_t o[2 * CTL];
+                uint32_t i, j;
+                pk = 0;
+                for (i = 0; i < FS / 2u; i += CTL) {
+                    mix_block(o, CTL);
+                    for (j = 0; j < 2u * CTL; j++)
+                        pk = fabs(o[j] / 32768.0) > pk ? fabs(o[j] / 32768.0) : pk;
+                }
+            }
+            if (trk[0].engine != seq[k] || pk >= 2.0)
+                printf("canvas:   switch %u: engine %u (want %u), peak %.3f\n", k, trk[0].engine, seq[k], pk);
+            ok &= trk[0].engine == seq[k] && pk < 2.0;
+            if (seq[k] == ENGI_CANVAS) {
+                cv_part_t *P = cv_of(&trk[0]);
+                uint32_t g;
+                for (g = 0; g < CV_NG; g++)
+                    if (P->g[g].owner && !(P->g[g].z && P->g[g].left)) {
+                        printf("canvas:   switch %u: grain %u stale\n", k, g);
+                        ok = 0;
+                    }
+            }
+            trk_note_on(&trk[0], 64, 100);
+        }
+        check("engine switches GRAIN -> CANVAS -> SAMPLE -> CANVAS while sounding: clean state, no clipping", ok);
+    }
+
+    /* 8. determinism */
+    {
+        static double a[FS / 2], b2[FS / 2];
+        int same = 1;
+        uint32_t i;
+        int32_t rng0;
+        setup(1);
+        rng0 = cv_rng[0] = 0x6C8E9CF5;
+        trk_note_on(&trk[0], 62, 100);
+        render(FS / 2u, a, 0, 0, 0);
+        setup(1);
+        cv_rng[0] = rng0;
+        trk_note_on(&trk[0], 62, 100);
+        render(FS / 2u, b2, 0, 0, 0);
+        for (i = 0; i < FS / 2u; i++)
+            same &= a[i] == b2[i];
+        check("a note from silence renders the same samples again (same random state)", same);
+    }
+
+    /* 9. cost against GRAIN */
+    {
+        static const uint8_t ch[4] = {48, 55, 60, 67};
+        uint64_t t0, tc = ~0ull, tg[16];
+        uint32_t rep, gp, gworst = 0, ng = ENGINES[ENGI_GRAIN_IDX]->npresets;
+        double cpu_c, cpu_g;
+        for (gp = 0; gp < 16u; gp++)
+            tg[gp] = ~0ull;
+        for (rep = 0; rep < 3u; rep++) {
+            setup(0);
+            for (c = 0; c < CV_COLS; c++)
+                cv_cells_set(&trk[0], c, 0xFFu);
+            trk[0].p[P_E1] = 127;
+            trk[0].p[P_E2] = 127;
+            trk[0].p[P_E3] = 127;
+            for (k = 0; k < 4u; k++)
+                trk_note_on(&trk[0], ch[k], 100);
+            render(FS, 0, 0, 0, 0);
+            t0 = now_ns();
+            render(FS * 2u, 0, 0, 0, 0);
+            t0 = now_ns() - t0;
+            tc = t0 < tc ? t0 : tc;
+            for (gp = 0; gp < ng && gp < 16u; gp++) {   /* GRAIN: its voice cap (3) of the same notes */
+                memset(trk, 0, sizeof trk);
+                host_tracks_init();
+                host_preset(&trk[0], ENGI_GRAIN_IDX, gp);
+                trk[0].p[P_CHOR] = trk[0].p[P_DLY] = trk[0].p[P_REV] = 0;
+                for (k = 0; k < 4u; k++)
+                    trk_note_on(&trk[0], ch[k], 100);
+                render(FS, 0, 0, 0, 0);
+                t0 = now_ns();
+                render(FS * 2u, 0, 0, 0, 0);
+                t0 = now_ns() - t0;
+                tg[gp] = t0 < tg[gp] ? t0 : tg[gp];
+            }
+        }
+        for (gp = 1; gp < ng && gp < 16u; gp++)          /* the heaviest preset (each at its best of three) */
+            if (tg[gp] > tg[gworst])
+                gworst = gp;
+        cpu_c = (double)tc / (FS * 2u);
+        cpu_g = (double)tg[gworst] / (FS * 2u);
+        snprintf(buf, sizeof buf, "cost: CANVAS heaviest %.1f ns/sample, GRAIN %s %.1f ns/sample: x%.2f <= %.1f",
+                 cpu_c, ENGINES[ENGI_GRAIN_IDX]->presets[gworst].name, cpu_g, cpu_c / cpu_g, CANVAS_COST_RATIO);
+        check(buf, cpu_c <= cpu_g * CANVAS_COST_RATIO);
+    }
+
+    /* 10. demos */
+    if (demo) {
+        static const uint8_t chord[3] = {57, 60, 64};
+        for (pi = 0; pi < ENG_CANVAS.npresets; pi++) {
+            FILE *f;
+            uint32_t i, n = FS * 6u;
+            static int32_t o[2 * CTL];
+            snprintf(buf, sizeof buf, "%s/canvas_%u_%s.wav", demo, pi + 1u, ENG_CANVAS.presets[pi].name);
+            if (!(f = fopen(buf, "wb")))
+                break;
+            memset(trk, 0, sizeof trk);
+            host_tracks_init();
+            host_preset(&trk[0], ENGI_CANVAS, pi);
+            wav_hdr(f, n);
+            for (k = 0; k < 3u; k++)
+                trk_note_on(&trk[0], chord[k], 100);
+            for (i = 0; i < n; i += CTL) {
+                uint32_t j;
+                if (i == FS * 4u)
+                    for (k = 0; k < 3u; k++)
+                        trk_note_off(&trk[0], chord[k]);
+                mix_block(o, CTL);
+                for (j = 0; j < CTL; j++)
+                    wav_put(f, o[2 * j], o[2 * j + 1]);
+            }
+            fclose(f);
+        }
+        {   /* the scan: CLOUDS' canvas, a slow LFO -> SHP moving every grain through the samples */
+            FILE *f;
+            uint32_t i, n = FS * 10u;
+            static int32_t o[2 * CTL];
+            snprintf(buf, sizeof buf, "%s/canvas_scan_lfo.wav", demo);
+            if ((f = fopen(buf, "wb"))) {
+                memset(trk, 0, sizeof trk);
+                host_tracks_init();
+                host_preset(&trk[0], ENGI_CANVAS, 1);
+                trk[0].p[P_LRATE] = 12;                    /* slow */
+                trk[0].p[P_LD_SHP] = 63;                    /* (its most: F_BIPCT -64..63) */
+                wav_hdr(f, n);
+                for (k = 0; k < 3u; k++)
+                    trk_note_on(&trk[0], chord[k], 100);
+                for (i = 0; i < n; i += CTL) {
+                    uint32_t j;
+                    if (i == FS * 8u)
+                        for (k = 0; k < 3u; k++)
+                            trk_note_off(&trk[0], chord[k]);
+                    mix_block(o, CTL);
+                    for (j = 0; j < CTL; j++)
+                        wav_put(f, o[2 * j], o[2 * j + 1]);
+                }
+                fclose(f);
+            }
+        }
+        printf("canvas: demos in %s\n", demo);
+    }
+    printf(bad ? "canvas: %d FAILED\n" : "canvas: all ok\n", bad);
+    return bad ? 1 : 0;
+}
